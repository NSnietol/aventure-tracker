# =============================================================================
# Adventure Tracker - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Email Configuration (Resend) — REQUIRED
# -----------------------------------------------------------------------------
# Get your free API key at https://resend.com (no credit card)
RESEND_API_KEY=re_your_api_key_here
EMAIL_TO=your@email.com

# -----------------------------------------------------------------------------
# Image Extraction (Gemini) — optional, faster than Ollama (~3s/image)
# -----------------------------------------------------------------------------
# Get your free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# -----------------------------------------------------------------------------
# GitHub Gist Configuration — only needed in CI (GitHub Actions)
# -----------------------------------------------------------------------------
# Create a secret Gist and generate a PAT with gist scope
GITHUB_GIST_ID=your_gist_id_here
GITHUB_GIST_TOKEN=your_personal_access_token_here

# -----------------------------------------------------------------------------
# Flight Threshold Overrides (optional — override routes.yaml values)
# -----------------------------------------------------------------------------
# Uncomment to override values in config/routes.yaml at runtime
# FLIGHT_PRICE_THRESHOLD=300000      # Max price per leg in COP (all routes)
# FLIGHT_BARGAIN_THRESHOLD=110000    # Any airline included at this price or below
# FLIGHT_EXTRA_MAX_PRICE=150000      # Max price for extra airlines (Wingo, JetSMART, Avianca)

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
CONFIG_DIR=config

# -----------------------------------------------------------------------------
# Scraping Settings
# -----------------------------------------------------------------------------
HEADLESS=true
MIN_DELAY_MS=1000
MAX_DELAY_MS=3000
